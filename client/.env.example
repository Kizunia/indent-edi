# Copy to .env and fill in. .env is git-ignored. See docs/architecture/dev-setup.md.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE   (URL-encode special characters in the password)
# Matches the Docker Compose MySQL at the repo root (port 3307).
DATABASE_URL="mysql://root:password@localhost:3307/indent_dev"
# Tests only. The database name MUST end in _test (tests refuse to run otherwise).
DATABASE_URL_TEST="mysql://root:password@localhost:3307/indent_test"

# Process timezone must be UTC (DEC-021).
TZ="UTC"

# Authentication (DEC-003): "dev" (user/role switcher, never in production) or "external".
AUTH_PROVIDER="dev"
# Secret used to sign the dev session cookie. Dev only.
DEV_SESSION_SECRET="change-me-dev-only"
# Where unauthenticated users are sent (TBD with the auth team).
AUTH_LOGIN_URL=""

# PROVISIONAL settings (SRS says TBD). See docs/open-questions.md.
APP_TIMEZONE="Asia/Kolkata"            # DEC-021
ALLOW_DUPLICATE_ITEMS="false"          # DEC-009
INDENT_NUMBER_PREFIX="IND-"            # DEC-010
INDENT_NUMBER_PAD="6"
ITEM_CODE_PREFIX="ITM-"                # DEC-010
ITEM_CODE_PAD="6"
